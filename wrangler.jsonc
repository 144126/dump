{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "dump",
	"account_id": "9bdf8703c380fa82142864bf5d99a2d7",
	"compatibility_date": "2026-09-30",
	"compatibility_flags": [
		"nodejs_als"
	],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"routes": [
		{
			"pattern": "dump.apexlinks.org",
			"custom_domain": true
		},
		{
			"pattern": "draft.apexlinks.org",
			"custom_domain": true
		}
	],
	"vars": {
		"PIN": "54"
	},
	"workers_dev": true,
	"preview_urls": true,
	"kv_namespaces": [
		{
			"binding": "KV",
			"id": "744b7128e2174b32b3c00a65a5e20774"
		}
	]
}